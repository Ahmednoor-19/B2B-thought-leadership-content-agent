{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "B2B Content Agent — Draft Output Contract",
  "type": "object",
  "required": ["draft_type", "hook_text", "post_body", "source_urls", "confidence_note", "generated_at"],
  "properties": {
    "draft_type": {
      "type": "string",
      "enum": ["scheduled_post", "breaking_news", "comment", "speaker_pitch"]
    },
    "hook_text": { "type": "string", "description": "Opening line or subject, standalone" },
    "post_body": { "type": "string", "description": "Full draft body, \\n between paragraphs" },
    "source_urls": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "confidence_note": { "type": "string", "description": "Anything a human must verify, or 'none'" },
    "target_profile_or_event": {
      "type": ["string", "null"],
      "description": "Person/event for comment & speaker_pitch, else null"
    },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
